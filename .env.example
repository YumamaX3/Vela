# ⛵ Vela environment contract
# This file reflects actual runtime usage in the current codebase.
# Full reference: docs/ENVIRONMENT.md

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/vela

# Recommended runtime variables
PORT=32060
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Storage posture (the Storage Covenant — plans/storage-covenant.md)
# sqlite | mysql | mirror
#   sqlite — single-store, exactly today
#   mysql  — MariaDB-only; an unreachable twin refuses boot LOUD (never silent)
#   mirror — sqlite PRIMARY serves; writes mirror to the twin through the
#            outbox pump (C3), usage rides a watermark resync (C4), and a
#            divergence sweep guards the twin (C4). A down twin degrades the
#            mirror — it NEVER silently downgrades the mode.
VELA_DB_MODE=sqlite
# mysql://user:pass@host:3306/vela — required for mysql/mirror postures
VELA_MYSQL_URL=

# Mirror tuning (Storage Covenant Waves C3–C4) — only read under mirror.
#VELA_MIRROR_MAX_RETRIES=5              # pump per-op retry budget before poison
#VELA_MIRROR_SWEEP_INTERVAL_MINUTES=360 # divergence sweep rhythm
#VELA_MIRROR_SWEEP_AUTORESYNC=true      # divergence > threshold → full resync
#VELA_MIRROR_DIVERGENCE_THRESHOLD=0     # diverged-table count before alert
#VELA_MIRROR_USAGE_BATCH_SIZE=500       # usage-resync rows per batch
#VELA_MIRROR_USAGE_RESYNC_INTERVAL_SECONDS=60
#VELA_MIRROR_USAGE_RESYNC_MAX_ROWS=5000 # usage-resync row cap per pass

# Backup engine (Storage Covenant Wave B) — all opt-in, default OFF.
# VELA_BACKUP_ENCRYPTION_KEY is required when enabled; its LOSS = permanently
# unrecoverable backups. Store it offline with the same care as the DB itself.
VELA_BACKUP_ENABLED=false
VELA_BACKUP_INTERVAL_HOURS=24
VELA_BACKUP_RETAIN_DAILY=7
VELA_BACKUP_RETAIN_WEEKLY=4
VELA_BACKUP_ENCRYPTION_KEY=
VELA_BACKUP_INCLUDE_REQUEST_DETAILS=false
VELA_BACKUP_S3_ENABLED=false
VELA_BACKUP_S3_ENDPOINT=
VELA_BACKUP_S3_BUCKET=vela-backups
VELA_BACKUP_S3_ACCESS_KEY=
VELA_BACKUP_S3_SECRET_KEY=
VELA_BACKUP_S3_REGION=us-east-1
# Usage retention purge — days, 0 = keep forever. Purge runs AFTER the
# scheduled backup so purged rows live in the artifact.
VELA_USAGE_RETENTION_DAYS=90

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:32060
CLOUD_URL=https://vela.my.id
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:32060
NEXT_PUBLIC_CLOUD_URL=https://vela.my.id

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=vela
